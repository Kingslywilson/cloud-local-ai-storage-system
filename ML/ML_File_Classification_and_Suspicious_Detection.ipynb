 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Gradious AI-Enhanced Cloud Storage Platform\n",
    "## Machine Learning Module: File Classification & Suspicious Upload Detection\n",
    "\n",
    "This notebook contains the complete machine learning workflow for:\n",
    "1. **File Category Classifier**: Classifying uploaded files into Document, Image, Video, Audio, and Code Files using a **Random Forest Classifier**.\n",
    "2. **Suspicious Upload Anomaly Detector**: Identifying normal vs. suspicious upload behaviors using a **Random Forest Classifier** trained on behavioral metadata.\n",
    "\n",
    "---"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 1. Environment Setup & Dependencies"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import joblib\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from pathlib import Path\n",
    "\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.metrics import classification_report, confusion_matrix, accuracy_score, f1_score\n",
    "from sklearn.preprocessing import OneHotEncoder, StandardScaler\n",
    "from sklearn.compose import ColumnTransformer\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.impute import SimpleImputer\n",
    "\n",
    "print(\"Libraries imported successfully.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "--- \n",
    "## Part 1: File Category Classification Model (Random Forest)\n",
    "\n",
    "### 1.1 Load File Classification Dataset"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "dataset_dir = Path(\"dataset\")\n",
    "train_path = dataset_dir / \"train.csv\"\n",
    "test_path = dataset_dir / \"test.csv\"\n",
    "\n",
    "if not train_path.exists():\n",
    "    # Fallback to reduced dataset if full split is unavailable\n",
    "    train_path = dataset_dir / \"file_classification_reduced.csv\"\n",
    "\n",
    "df_train = pd.read_csv(train_path)\n",
    "df_test = pd.read_csv(test_path) if test_path.exists() else None\n",
    "\n",
    "print(f\"Train dataset shape: {df_train.shape}\")
    "if df_test is not None:\n",
    "    print(f\"Test dataset shape: {df_test.shape}\")\n",
    "\n",
    "df_train.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 1.2 Data Preprocessing & Pipeline Construction"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "target_col = \"category\"\n",
    "drop_cols = [c for c in [\"filename\", \"relative_path\", target_col] if c in df_train.columns]\n",
    "\n",
    "X_train = df_train.drop(columns=drop_cols)\n",
    "y_train = df_train[target_col]\n",
    "\n",
    "categorical_cols = X_train.select_dtypes(include=[\"object\", \"category\"]).columns.tolist()\n",
    "numerical_cols = X_train.select_dtypes(include=[\"int64\", \"float64\"]).columns.tolist()\n",
    "\n",
    "numeric_transformer = Pipeline([\n",
    "    (\"imputer\", SimpleImputer(strategy=\"median\")),\n",
    "    (\"scaler\", StandardScaler())\n",
    "])\n",
    "\n",
    "categorical_transformer = Pipeline([\n",
    "    (\"imputer\", SimpleImputer(strategy=\"constant\", fill_value=\"missing\")),\n",
    "    (\"onehot\", OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False))\n",
    "])\n",
    "\n",
    "preprocessor = ColumnTransformer(transformers=[\n",
    "    (\"num\", numeric_transformer, numerical_cols),\n",
    "    (\"cat\", categorical_transformer, categorical_cols)\n",
    "])\n",
    "\n",
    "clf_pipeline = Pipeline([\n",
    "    (\"preprocessor\", preprocessor),\n",
    "    (\"classifier\", RandomForestClassifier(n_estimators=100, random_state=42, n_jobs=-1))\n",
    "])\n",
    "\n",
    "print(\"Preprocessing pipeline configured successfully.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 1.3 Train Model & Evaluate Performance"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "clf_pipeline.fit(X_train, y_train)\n",
    "\n",
    "if df_test is not None:\n",
    "    X_test = df_test.drop(columns=[c for c in [\"filename\", \"relative_path\", target_col] if c in df_test.columns])\n",
    "    y_test = df_test[target_col]\n",
    "else:\n",
    "    X_train_sub, X_test, y_train_sub, y_test = train_test_split(X_train, y_train, test_size=0.2, random_state=42)\n",
    "\n",
    "y_pred = clf_pipeline.predict(X_test)\n",
    "acc = accuracy_score(y_test, y_pred)\n",
    "f1 = f1_score(y_test, y_pred, average=\"weighted\")\n",
    "\n",
    "print(f\"Accuracy Score: {acc:.4f}\")\n",
    "print(f\"Weighted F1-Score: {f1:.4f}\\n\")\n",
    "print(\"Classification Report:\")\n",
    "print(classification_report(y_test, y_pred))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "--- \n",
    "## Part 2: Suspicious Upload Detection Model V2 (Random Forest)\n",
    "\n",
    "### 2.1 Load Suspicious Upload Dataset V2"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "susp_train_path = dataset_dir / \"suspicious_upload_train_v2.csv\"\n",
    "susp_test_path = dataset_dir / \"suspicious_upload_test_v2.csv\"\n",
    "\n",
    "if not susp_train_path.exists():\n",
    "    susp_train_path = dataset_dir / \"suspicious_upload_dataset_v2.csv\"\n",
    "\n",
    "df_susp_train = pd.read_csv(susp_train_path)\n",
    "df_susp_test = pd.read_csv(susp_test_path) if susp_test_path.exists() else None\n",
    "\n",
    "print(f\"Suspicious Train dataset shape: {df_susp_train.shape}\")\n",
    "df_susp_train.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 2.2 Train Suspicious Upload Anomaly Detector Pipeline"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "susp_target = \"label\"\n",
    "drop_cols_susp = [c for c in [\"is_suspicious\", susp_target] if c in df_susp_train.columns]\n",
    "\n",
    "X_susp_train = df_susp_train.drop(columns=drop_cols_susp)\n",
    "y_susp_train = df_susp_train[susp_target]\n",
    "\n",
    "cat_susp = X_susp_train.select_dtypes(include=[\"object\", \"category\"]).columns.tolist()\n",
    "num_susp = X_susp_train.select_dtypes(include=[\"int64\", \"float64\"]).columns.tolist()\n",
    "\n",
    "preprocessor_susp = ColumnTransformer(transformers=[\n",
    "    (\"num\", numeric_transformer, num_susp),\n",
    "    (\"cat\", categorical_transformer, cat_susp)\n",
    "])\n",
    "\n",
    "susp_pipeline = Pipeline([\n",
    "    (\"preprocessor\", preprocessor_susp),\n",
    "    (\"classifier\", RandomForestClassifier(n_estimators=100, random_state=42, n_jobs=-1))\n",
    "])\n",
    "\n",
    "susp_pipeline.fit(X_susp_train, y_susp_train)\n",
    "\n",
    "if df_susp_test is not None:\n",
    "    X_susp_test = df_susp_test.drop(columns=[c for c in [\"is_suspicious\", susp_target] if c in df_susp_test.columns])\n",
    "    y_susp_test = df_susp_test[susp_target]\n",
    "else:\n",
    "    X_susp_train, X_susp_test, y_susp_train, y_susp_test = train_test_split(X_susp_train, y_susp_train, test_size=0.2, random_state=42)\n",
    "\n",
    "y_susp_pred = susp_pipeline.predict(X_susp_test)\n",
    "acc_susp = accuracy_score(y_susp_test, y_susp_pred)\n",
    "print(f\"Suspicious Detector Accuracy: {acc_susp:.4f}\\n\")\n",
    "print(classification_report(y_susp_test, y_susp_pred))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "--- \n",
    "## Part 3: Model Persistence & Verification\n",
    "\n",
    "### 3.1 Save Trained Models as Joblib Assets"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "models_dir = Path(\"models\")\n",
    "models_dir.mkdir(exist_ok=True)\n",
    "\n",
    "model_path_1 = models_dir / \"file_classifier_random_forest.joblib\"\n",
    "model_path_2 = models_dir / \"suspicious_upload_random_forest_v2.joblib\"\n",
    "\n",
    "joblib.dump(clf_pipeline, model_path_1)\n",
    "joblib.dump(susp_pipeline, model_path_2)\n",
    "\n",
    "print(f\"Saved File Classification Model -> {model_path_1}\")\n",
    "print(f\"Saved Suspicious Upload Model -> {model_path_2}\")"
   ]
  }
 ],
